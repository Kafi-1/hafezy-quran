<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude the read-position DB from Auto Backup: it is device-local and
     restoring it on a new device would point at meaningless page numbers. -->
<full-backup-content>
    <exclude domain="database" path="hafezi_quran.db" />
    <exclude domain="database" path="hafezi_quran.db-shm" />
    <exclude domain="database" path="hafezi_quran.db-wal" />
</full-backup-content>
