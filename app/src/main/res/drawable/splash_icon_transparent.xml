<?xml version="1.0" encoding="utf-8"?>
<!--
  A fully transparent splash icon. Android 12+ always draws a system splash
  window with the app icon by default; pointing windowSplashScreenAnimatedIcon
  here suppresses that icon so the launch goes straight into our own Compose
  splash instead of flashing a second logo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
