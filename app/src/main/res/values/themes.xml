<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light base theme. Compose owns all in-app styling; this only sets the
         window background before the first frame so there is no white flash.

         The two windowSplashScreen* items apply on Android 12+, where the system
         always draws a launch window. A transparent icon here keeps that window
         from showing a second logo; the background matches the View splash that
         follows so the hand-off is seamless. -->
    <style name="Theme.HafeziQuran" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/brand_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
    </style>

    <!-- Keeps the launch window a plain cream field (matching the View splash) and
         dark status-bar icons while it is on screen. Inherits the transparent
         Android 12+ splash icon so no logo flashes over it. -->
    <style name="Theme.HafeziQuran.Splash" parent="Theme.HafeziQuran">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
