<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimalist welcome screen: a soft cream field with only the app name. Every
  element is animated in code (SplashActivity); this file deliberately holds no
  bitmap, logo or decal.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream">

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="@color/brand_green"
        android:textSize="32sp"
        android:textStyle="bold" />

</FrameLayout>
