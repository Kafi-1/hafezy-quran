<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Model/PDF downloads and audio streaming -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Prayer times: optional district or GPS location setup -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Adhan alarms: exact delivery at prayer time and survival across reboot -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Exact-alarm capability without the per-app settings trip. This is an
         alarm/reminder app; Play requires a declaration for this permission. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Digital Tasbeeh haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sobok: on-device recitation checking -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Audio Quran: keep reciting with the screen off, with transport controls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HafeziQuranApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HafeziQuran"
        tools:targetApi="35">

        <!-- First-launch welcome; the real entry point. Shows a one-off animation
             then hands off to MainActivity. -->
        <activity
            android:name=".presentation.screens.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HafeziQuran.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.HafeziQuran"
            android:windowSoftInputMode="adjustResize" />

        <!-- Audio Quran playback. media3 owns the notification and lock-screen
             controls; the UI talks to it only via a MediaController. -->
        <service
            android:name=".playback.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Prayer-time adhan. The alarm fires a receiver, which starts this
             foreground service to play the user's chosen audio. -->
        <service
            android:name=".prayer.AdhanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".prayer.AdhanReceiver"
            android:exported="false" />

        <!-- Sehri/iftar reminders. Same exact-alarm mechanics as the adhan, but
             delivered as a high-priority notification instead of audio. -->
        <receiver
            android:name=".prayer.RamadanAlarmReceiver"
            android:exported="false" />

        <!-- Rebuild adhan alarms after reboot, clock/timezone changes, or update. -->
        <receiver
            android:name=".prayer.AlarmRescheduleReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
